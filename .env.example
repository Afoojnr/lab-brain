# Where the live SQLite database is kept. Keep it on a local disk, not on a
# synced or network drive (SQLite can be corrupted there; backups cover that).
# LAB_BRAIN_DATA_DIR=./data
# LAB_BRAIN_DATABASE_URL=file:./data/lab-brain.db

# Where uploaded files are kept (default ./storage). The Data folder chosen in
# Settings is used when this is not set.
# LAB_BRAIN_STORAGE_DIR=./storage

# The public demo (set this only on the deployed demo, never on a normal install):
# temporary database and files, seeded with example data, nothing is kept.
# LAB_BRAIN_DEMO=true

# The public address, for link previews (Open Graph, Twitter). Defaults to
# http://localhost:3000.
# LAB_BRAIN_SITE_URL=https://lab-brain-demo.onrender.com

# Let search engines index the site. Off by default.
# LAB_BRAIN_ALLOW_INDEXING=true

